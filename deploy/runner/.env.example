# Copy to .env next to docker-compose.yml.

# Password for the noVNC desktop. Long and random: this desktop can trade the wallet.
VNC_PASSWORD=change-me
VNC_USER=limil

# Where to publish noVNC. 127.0.0.1 keeps it local (reach it over SSH tunnel or
# a reverse proxy with TLS); 0.0.0.0 exposes it to the internet, only behind a
# firewall rule limited to your own IP.
BIND_ADDR=127.0.0.1

TZ=UTC

# The hub (the `daemon` service) the laptop pairs with: the address of this
# server as the laptop sees it.
#
# The extension refuses a plain-http pairing string to a PUBLIC address. Either
# leave the hub local (DAEMON_BIND_ADDR=127.0.0.1, PUBLIC_URL empty) and pair
# over an SSH tunnel, `ssh -L 8787:127.0.0.1:8787 user@server`, then paste
# http://127.0.0.1:8787#<token>, or give the hub TLS (DAEMON_TLS_* below, or a
# reverse proxy) and set PUBLIC_URL=https://<host>:8787. A VPN / private
# address (10.x, 192.168.x, Tailscale) is accepted over plain http.
PUBLIC_URL=
DAEMON_BIND_ADDR=127.0.0.1
# Host port for the hub; change it when 8787 is taken on the server.
DAEMON_HOST_PORT=8787

# TLS in the hub itself. Put the files into ./certs (or point CERTS_DIR at the
# directory that holds them); that directory is mounted into the container as
# /certs, so the two paths below are CONTAINER paths and must start with
# /certs/. A host path here (./certs/fullchain.pem) makes the hub fail on start
# with ENOENT and restart in a loop. Leave both empty for plain http.
#
#   DAEMON_TLS_CERT=/certs/fullchain.pem
#   DAEMON_TLS_KEY=/certs/privkey.pem
DAEMON_TLS_CERT=
DAEMON_TLS_KEY=
CERTS_DIR=./certs

# How scripts/update.sh (and the timer from enable-autoupdate.sh) moves this
# checkout. `signed`: only to a release tag whose signature verifies against
# deploy/allowed_signers; nothing moves while that file lists no key or no
# signed tag exists yet. `main`: fast-forward to origin/main without
# verification; weaker, and the only mode that updates until a maintainer key
# is listed. Empty means `signed`.
LIMIL_UPDATE_MODE=
